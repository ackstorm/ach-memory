{
  "description": "ach-memory lifecycle - loads standing context and provides retain guidance. Codex expands ${PLUGIN_ROOT}, not ${CLAUDE_PLUGIN_ROOT}.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 5,
            "statusMessage": "Loading ach-memory..."
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/subagent-start.sh\"",
            "timeout": 5,
            "statusMessage": "Loading ach-memory..."
          }
        ],
        "matcher": "startup"
      }
    ]
  }
}
