{
  "description": "ach-memory activation - announces the memory tools, never calls them. Codex expands ${PLUGIN_ROOT}, not ${CLAUDE_PLUGIN_ROOT}: the Agent Plugins spec name, and what engram's codex plugin uses.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 5,
            "statusMessage": "Loading ach-memory..."
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/subagent-start.sh\"",
            "timeout": 5,
            "statusMessage": "Loading ach-memory..."
          }
        ],
        "matcher": "startup"
      }
    ]
  }
}
