{
  "description": "ach-memory activation - announces the memory tools, never calls them",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 5,
            "statusMessage": "Loading ach-memory..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-start.sh\"",
            "timeout": 5,
            "statusMessage": "Loading ach-memory..."
          }
        ]
      }
    ]
  }
}
