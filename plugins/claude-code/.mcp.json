{
  "mcpServers": {
    "ach-memory": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ackstorm/ach-memory@v0.7.4",
        "ach-memory",
        "mcp",
        "--url",
        "${ACH_MEMORY_URL:-http://localhost:8000/mcp/}"
      ],
      "env": {
        "ACH_MEMORY_API_KEY": "${ACH_MEMORY_API_KEY}",
        "ACH_MEMORY_HEADER": "${ACH_MEMORY_HEADER:-Authorization}"
      }
    }
  }
}
