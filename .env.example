# Copy to .env for the local Compose stack. It holds the operator credential;
# keep it out of version control. Set MEMORY_MASTER_KEY and its SHA-256 hash.
MEMORY_MASTER_KEY=
MEMORY_MASTER_KEY_HASH=
HINDSIGHT_LLM_PROVIDER=mock
HINDSIGHT_LLM_MODEL=mock-model
HINDSIGHT_LLM_BASE_URL=http://127.0.0.1:9
HINDSIGHT_LLM_API_KEY=dummy

# External identity (optional; both providers may be enabled together).
# The issuer must match the token's `iss` claim exactly, so it stays the
# public URL even when JWKS is fetched in-cluster -- override the JWKS URI
# for that.
# MEMORY_AUTH_JWT_ENABLED=true
# MEMORY_AUTH_JWT_ISSUER=https://ach.example.com
# MEMORY_AUTH_JWT_JWKS_URI=http://ach.ach.svc/.well-known/jwks.json
# MEMORY_AUTH_JWT_AUDIENCE=mcp:ach-memory
# MEMORY_AUTH_JWT_VERIFY_AUDIENCE=true
# MEMORY_AUTH_JWT_GROUPS_CLAIM=groups
# MEMORY_AUTH_PLATFORM_ENABLED=true
# MEMORY_AUTH_PLATFORM_INCOMING_HEADER=x-litellm-api-key
# MEMORY_AUTH_PLATFORM_RESOLVER_HEADER=x-litellm-api-key
# MEMORY_AUTH_PLATFORM_RESOLVER_URL=http://litellm.genai.svc/v2/user/info
# MEMORY_AUTH_PLATFORM_CACHE_TTL=300
# MEMORY_AUTH_PLATFORM_GROUPS_FIELD=team_id

# Where the session brief's user/project sections are compiled from.
# `legacy` reads the prose digest in `ach-memory-session-brief`; `structured`
# reads the typed profile in `ach-memory-profile-v1` instead, with no fallback
# between them -- a structured read that finds nothing serves no section.
# Left commented, so the default applies: `legacy`, everywhere. Flipping it is
# a separately authorized rollout step per deployment, and only after the bank
# has been provisioned with a profile model and the evaluator has measured
# what its synthesis actually produces. A bank that has never been provisioned
# would deliver an empty brief the moment this flipped.
# MEMORY_PROFILE_DELIVERY_MODE=legacy

# Which bank the non-persisting profile evaluator measures
# (`docker compose --profile profile-evaluation run --rm profile-evaluator`).
# No target ships: both stay unset until an operator names one, and the
# container exits 2 without them. `profile-check` is measurement only -- it
# never provisions, updates, refreshes or retains anything -- and it does
# not read MEMORY_PROFILE_DELIVERY_MODE, which stays legacy.
# MEMORY_PROFILE_CHECK_SCOPE=user
# MEMORY_PROFILE_CHECK_PROJECT=acme-api
