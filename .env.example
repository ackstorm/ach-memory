# Copy to .env for the local compose stack. .env is git-ignored and must stay
# that way -- it holds a working credential.
#
# Generate the pair rather than inventing one; the hash is what the service
# reads, the plaintext is what you authenticate with:
#
#   export MEMORY_MASTER_KEY="mem_local_$(openssl rand -hex 32)"
#   export MEMORY_MASTER_KEY_HASH=$(python3 -c \
#     "import hashlib,os; print(hashlib.sha256(os.environ['MEMORY_MASTER_KEY'].encode()).hexdigest())")
#
# Every other MEMORY_* setting has a working default for local development --
# see the Configuration table in README.md. docker-compose.yml supplies the
# database and Hindsight URLs.
MEMORY_MASTER_KEY=
MEMORY_MASTER_KEY_HASH=
