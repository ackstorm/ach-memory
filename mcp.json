{
  "mcpServers": {
    "ach-memory": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-m",
        "memory.cli",
        "mcp"
      ],
      "env": {
        "ACH_MEMORY_URL": "${ACH_MEMORY_URL:-}",
        "ACH_MEMORY_API_KEY": "${ACH_MEMORY_API_KEY:-}",
        "ACH_MEMORY_HEADER": "${ACH_MEMORY_HEADER:-Authorization}",
        "ACH_MEMORY_TOKEN_COMMAND": "${ACH_MEMORY_TOKEN_COMMAND:-}"
      }
    }
  }
}
