{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id", "action", "scope", "memory_type", "basis", "trigger",
          "claim_count", "has_expiry", "evidence_shape"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^case-[0-9]{2}$"},
          "action": {"enum": ["retain", "working_state", "abstain", "correct", "supersede"]},
          "scope": {"type": ["string", "null"], "enum": ["user", "project", null]},
          "memory_type": {"type": ["string", "null"], "enum": ["decision", "constraint", "preference", "convention", "fact", "gotcha", null]},
          "basis": {"type": ["string", "null"], "enum": ["human_explicit", "agent_verified", null]},
          "trigger": {"type": ["string", "null"], "enum": ["user_requested", "agent_proactive", null]},
          "claim_count": {"type": "integer", "minimum": 0, "maximum": 5},
          "has_expiry": {"type": "boolean"},
          "evidence_shape": {"enum": ["minimal_raw", "none"]}
        }
      }
    }
  }
}
